# Copy this file to .env and fill in your own values.  NEVER commit .env to GitHub.
# Everything below is a PLACEHOLDER. Do not paste real keys into this example file.

# ---- Groq API keys ----------------------------------------------------------
# Primary key (required for live answers): https://console.groq.com/keys
GROQ_API_KEY=REPLACE_WITH_YOUR_PRIMARY_GROQ_KEY
# Optional ordered backups, tried only after Groq answers 401 (invalid/revoked key). Leave blank if unused.
# Rate limits (429) are shared across a Groq organization, so backup keys from the SAME organization do
# not raise the limit and are never rotated for a 429. Use backups for key loss/revocation.
GROQ_API_KEY_BACKUP_1=
GROQ_API_KEY_BACKUP_2=
# Total provider calls per request (covers failover and the single Retry-After retry), default 3
PROVIDER_MAX_ATTEMPTS=3
# Longest Retry-After (seconds) Mirsad will wait on a 429 before returning a clear error, default 10
PROVIDER_RETRY_AFTER_MAX_S=10

# ---- Answering models (LiteLLM format: provider/model) ------------------------
# Verify both exist and support tool calling: https://console.groq.com/docs/models
# SMALL_MODEL must be cheaper than BIG_MODEL per input AND output token (see README, "Answering models").
SMALL_MODEL=groq/openai/gpt-oss-20b
BIG_MODEL=groq/openai/gpt-oss-120b

# 1 = simulated answers (no provider calls). 0 = live Groq answers.
MIRSAD_MOCK=1

# ---- Routing: rules | shadow | local_llm ---------------------------------------
# local_llm: a local Qwen model (Ollama) classifies each user turn; Mirsad picks SMALL_MODEL or BIG_MODEL.
MIRSAD_ROUTING_MODE=local_llm
CLASSIFIER_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
CLASSIFIER_TIMEOUT_S=20

# ---- Loop guard / router / limits --------------------------------------------
LOOP_THRESHOLD=3
ROUTER_THRESHOLD=3
MAX_TOKENS=500

# ---- Where the agent and dashboard find the proxy -------------------------------
PROXY_URL=http://localhost:8000/v1

# ---- Accounts (Supabase Auth). Placeholders only: fill these in your own .env ---------------------
# Supabase dashboard > Project Settings > API. The PUBLISHABLE key only; never put a service-role key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_SUPABASE_PUBLISHABLE_KEY
# Long random secrets (python -c "import secrets; print(secrets.token_urlsafe(40))"). Different value for each.
MIRSAD_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
MIRSAD_SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
# The address users open. Use https://... in production (cookies then become Secure).
MIRSAD_PUBLIC_URL=http://localhost:8501
# Optional: session idle hours (12), absolute days (7), chat messages per user per minute (20)
# MIRSAD_SESSION_IDLE_HOURS=12
# MIRSAD_SESSION_MAX_DAYS=7
# MIRSAD_CHAT_RATE_PER_MIN=20
